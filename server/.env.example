PORT=5000
NODE_ENV=development
MONGODB_URI=
# Must be a random string of at least 32 characters (256 bits recommended).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_URL=http://localhost:5173
# server mode: the API persists the message and sends the email notification
# itself, so submissions stay behind the server's rate limiting and validation.
CONTACT_NOTIFICATION_MODE=server
# Email notification providers — Resend is tried first, Web3Forms as fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
WEB3FORMS_ACCESS_KEY=
