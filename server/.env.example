PORT=5000
NODE_ENV=development
MONGODB_URI=
# Must be a random string of at least 32 characters (256 bits recommended).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_URL=http://localhost:5173
# Use browser mode when the React app sends email directly through Web3Forms.
CONTACT_NOTIFICATION_MODE=browser
# Server-side Web3Forms fallback only. Render can be blocked by Cloudflare, so prefer browser mode.
WEB3FORMS_ACCESS_KEY=
